# ---- Chain (public, safe to commit defaults) ----
NEXT_PUBLIC_COOKIE_RPC_URL=https://rpc.cookiescan.io
NEXT_PUBLIC_COOKIE_WSS_URL=wss://cookiescan.io
NEXT_PUBLIC_COOKIESCAN_BASE=https://cookiescan.io
NEXT_PUBLIC_DAS_API_BASE=https://api.cookiescan.io
NEXT_PUBLIC_COOKIEBOX_AGG=https://agg.cookiebox.app
NEXT_PUBLIC_CANDYSHOP_SWAP=https://swap.cookiescan.io

# ---- App ----
NEXT_PUBLIC_APP_NAME=Sous
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- MCP proxy (server-side only, never NEXT_PUBLIC_) ----
# Local cookie-mcp in external-signer mode, e.g. COOKIE_SIGNER=external npx cookie-mcp --http 8787
MCP_HTTP_URL=http://127.0.0.1:8787/mcp
MCP_TIMEOUT_MS=45000
# Optional shared secret if your MCP server sits behind auth
# MCP_AUTH_TOKEN=

# ---- Solana mainnet side (for bridge view only) ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
