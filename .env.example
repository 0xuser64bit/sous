# ---- Chain (public, safe to commit defaults) ----
NEXT_PUBLIC_COOKIE_RPC_URL=https://rpc.cookiescan.io
# Optional. Defaults to the RPC host with a wss:// scheme. Do NOT point this at
# the explorer domain (cookiescan.io) — that serves HTML, not a JSON-RPC socket.
# Nothing subscribes today (confirmations poll over HTTP), so this is only a
# guard against a future subscriber picking the wrong host.
NEXT_PUBLIC_COOKIE_WSS_URL=wss://rpc.cookiescan.io
NEXT_PUBLIC_COOKIESCAN_BASE=https://cookiescan.io

# ---- MCP sidecar (server-side only, never NEXT_PUBLIC_) ----
# Local cookie-mcp in external-signer mode:
#   COOKIE_SIGNER=external npx -y cookie-mcp --http 8787
MCP_HTTP_URL=http://127.0.0.1:8787/mcp
MCP_TIMEOUT_MS=45000
# Optional shared secret when the sidecar sits behind auth. The app forwards it
# as `Authorization: Bearer <token>` — set the same value on both ends.
# MCP_AUTH_TOKEN=

# ---- Read by the sidecar process, not by this app ----
# cookie-mcp needs a Solana RPC for the bridge and for chain:"solana" quotes.
# Set it in the sidecar's environment; listed here so a single .env can start
# both processes.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
